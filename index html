        // ==========================================
        // 1. WEB AUDIO SYNTHESIZER
        // ==========================================
        const AudioEngine = {
            ctx: null,
            muted: false,
            init() {
                if (!this.ctx) {
                    const AudioCtx = window.AudioContext || window.webkitAudioContext;
                    if (AudioCtx) this.ctx = new AudioCtx();
                }
            },
            toggleMute() {
                this.muted = !this.muted;
                const btn = document.getElementById('btn-sound');
                if (btn) btn.textContent = this.muted ? '🔇 MUTE' : '🔊 SFX';
            },
            playTone(freq, type = 'square', duration = 0.12, vol = 0.08, delay = 0) {
                if (this.muted) return;
                this.init();
                if (!this.ctx) return;
                try {
                    const osc = this.ctx.createOscillator();
                    const gain = this.ctx.createGain();
                    osc.type = type;
                    osc.frequency.setValueAtTime(freq, this.ctx.currentTime + delay);
                    gain.gain.setValueAtTime(vol, this.ctx.currentTime + delay);
                    gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + delay + duration);
                    osc.connect(gain);
                    gain.connect(this.ctx.destination);
                    osc.start(this.ctx.currentTime + delay);
                    osc.stop(this.ctx.currentTime + delay + duration);
                } catch (e) {}
            },
            sfxStep() { this.playTone(140, 'triangle', 0.04, 0.03); },
            sfxEncounter() {
                [523, 659, 784, 1046, 784, 1046].forEach((f, i) => this.playTone(f, 'square', 0.09, 0.07, i * 0.07));
            },
            sfxHit() {
                this.playTone(180, 'sawtooth', 0.12, 0.1);
                this.playTone(110, 'square', 0.15, 0.1, 0.05);
            },
            sfxCatch() {
                [440, 554, 659, 880].forEach((f, i) => this.playTone(f, 'triangle', 0.14, 0.09, i * 0.11));
            },
            sfxHeal() {
                [523, 659, 784, 1046].forEach((f, i) => this.playTone(f, 'sine', 0.16, 0.09, i * 0.14));
