                voltbird: `<svg viewBox="0 0 100 100" class="w-full h-full drop-shadow-md"><g ${transform}>
                    <polygon points="20,52 42,44 38,62" fill="#eab308"/>
                    <polygon points="80,52 58,44 62,62" fill="#eab308"/>
                    <ellipse cx="50" cy="54" rx="18" ry="22" fill="#fef08a"/>
                    <polygon points="44,32 50,14 56,32" fill="#f59e0b"/>
                    <circle cx="44" cy="44" r="3" fill="#0f172a"/>
                    <circle cx="56" cy="44" r="3" fill="#0f172a"/>
                    <polygon points="46,48 54,48 50,56" fill="#f97316"/>
                </g></svg>`
            };
            return sprites[id] || sprites.embercub;
        }

        const TYPE_CHART = {
            fire: { grass: 2, water: 0.5, fire: 0.5, electric: 1, normal: 1 },
            water: { fire: 2, grass: 0.5, water: 0.5, electric: 1, normal: 1 },
            grass: { water: 2, fire: 0.5, grass: 0.5, electric: 1, normal: 1 },
            electric: { water: 2, grass: 0.5, electric: 0.5, fire: 1, normal: 1 },
            normal: { fire: 1, water: 1, grass: 1, electric: 1, normal: 1 }
        };

        function createMonsterInstance(speciesId, level = 5) {
            const base = MONSTER_DEX[speciesId];
            const maxHp = base.baseHp + level * 4;
            return {
                uid: Math.random().toString(36).slice(2, 9),
                speciesId,
                name: base.name,
                type: base.type,
                level,
                hp: maxHp,
                maxHp,
                atk: base.atk + Math.floor(level * 1.8),
                def: base.def + Math.floor(level * 1.5),
                spd: base.spd + Math.floor(level * 1.5),
                xp: 0,
                nextXp: level * 30,
                moves: base.moves.map(m => ({ ...m, currentPp: m.pp }))
            };
        }

        // ==========================================
        // 3. GAME STATE & SIMULATED + FIREBASE SERVER
        // ==========================================
        const state = {
            userId: 'local-' + Math.random().toString(36).slice(2, 8),
            trainerName: 'Trainer',
            starterChoice: 'embercub',
            money: 500,
            wins: 0,
            caughtCount: 1,
            party: [],
            bag: { potion: 3, orb: 5, superorb: 1 },
            playerPos: { x: 8, y: 8 },
            playerDir: 'down',
            inBattle: false,
            battle: null,
            onlineTrainers: {},
            db: null,
            auth: null,
            appId: 'pokeverse-online',
            firebaseReady: false
        };

        const SERVER_BOTS = [
            { uid: 'bot-red', name: 'Champion Red', level: 8, monster: 'embercub', wins: 42, caught: 18, status: 'In Lobby', isBot: true, updatedAt: Date.now() },
            { uid: 'bot-misty', name: 'Misty_Water', level: 6, monster: 'aquafin', wins: 19, caught: 11, status: 'Exploring', isBot: true, updatedAt: Date.now() },
            { uid: 'bot-surge', name: 'Lt. Surge', level: 7, monster: 'sparkmouse', wins: 27, caught: 14, status: 'Ready for PvP', isBot: true, updatedAt: Date.now() }
        ];

        function logServer(msg) {
            const box = document.getElementById('server-log-console');
            if (!box) return;
            const time = new Date().toLocaleTimeString([], { hour12: false });
            const div = document.createElement('div');
            div.textContent = `[${time}] ${msg}`;
            box.appendChild(div);
            box.scrollTop = box.scrollHeight;
        }

        function showToast(msg) {
            const el = document.getElementById('toast-banner');
            const txt = document.getElementById('toast-text');
            if (!el || !txt) return;
            txt.textContent = msg;
            el.classList.remove('hidden');
            clearTimeout(window._toastTimer);
            window._toastTimer = setTimeout(() => el.classList.add('hidden'), 3000);
        }

        async function initMultiplayerBackend() {
            try {
                if (typeof __firebase_config !== 'undefined' && __firebase_config) {
                    const firebaseConfig = JSON.parse(__firebase_config);
                    state.appId = typeof __app_id !== 'undefined' ? __app_id : 'pokeverse-online';
                    const app = initializeApp(firebaseConfig);
                    state.auth = getAuth(app);
                    state.db = getFirestore(app);

                    if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
                        await signInWithCustomToken(state.auth, __initial_auth_token);
                    } else {
                        await signInAnonymously(state.auth);
                    }

                    if (state.auth.currentUser) {
                        state.userId = state.auth.currentUser.uid;
                        state.firebaseReady = true;
                        logServer(`Authenticated with Cloud Relay (${state.userId.slice(0, 8)}...)`);
                        subscribeToOnlineServer();
                    }
                } else {
                    logServer('Running in Local Simulated Server Mode.');
                }
            } catch (err) {
                logServer(`Relay fallback active: ${err.message}`);
            }
            const uidTag = document.getElementById('your-uid-tag');
            if (uidTag) uidTag.textContent = `ID: ${state.userId.slice(0, 10)}`;
            renderLobbyAndLeaderboard();
        }

        function subscribeToOnlineServer() {
            if (!state.firebaseReady || !state.auth.currentUser) return;
            const trainersCol = collection(state.db, 'artifacts', state.appId, 'public', 'data', 'trainers');
            onSnapshot(trainersCol, (snap) => {
                snap.docChanges().forEach((change) => {
                    if (change.type === 'removed') {
                        delete state.onlineTrainers[change.doc.id];
                    } else {
                        const data = change.doc.data();
                        state.onlineTrainers[change.doc.id] = { uid: change.doc.id, ...data, isBot: false };
                    }
                });
                renderLobbyAndLeaderboard();
            }, (err) => logServer(`Presence sync warning: ${err.message}`));

            const chatCol = collection(state.db, 'artifacts', state.appId, 'public', 'data', 'global_chat');
            onSnapshot(chatCol, (snap) => {
                const msgs = [];
                snap.forEach(d => msgs.push({ id: d.id, ...d.data() }));
                msgs.sort((a, b) => (a.clientTime || 0) - (b.clientTime || 0));
                renderChatMessages(msgs.slice(-30));
            }, (err) => logServer(`Chat sync warning: ${err.message}`));
        }

        async function syncTrainerPresence(statusText = 'Exploring') {
            const lead = state.party[0] || createMonsterInstance(state.starterChoice, 5);
            const payload = {
                name: state.trainerName,
                level: lead.level,
                monster: lead.speciesId,
                wins: state.wins,
                caught: state.caughtCount,
                status: statusText,
                updatedAt: Date.now()
            };
            state.onlineTrainers[state.userId] = { uid: state.userId, ...payload, isBot: false };
            renderLobbyAndLeaderboard();

            if (state.firebaseReady && state.auth.currentUser) {
                try {
                    const ref = doc(state.db, 'artifacts', state.appId, 'public', 'data', 'trainers', state.userId);
                    await setDoc(ref, payload, { merge: true });
                } catch (e) {}
            }
        }

        // ==========================================
        // 4. STARTER SETUP & UI UPDATES
        // ==========================================
        window.selectStarterChoice = function(id) {
            state.starterChoice = id;
            ['embercub', 'aquafin', 'leafsprout'].forEach(k => {
                const card = document.getElementById(`starter-card-${k}`);
                if (!card) return;
                if (k === id) {
                    card.classList.remove('border-slate-700', 'bg-slate-800/50');
                    card.classList.add('border-amber-400', 'bg-slate-800/90');
                } else {
                    card.classList.add('border-slate-700', 'bg-slate-800/50');
                    card.classList.remove('border-amber-400', 'bg-slate-800/90');
                }
            });
            AudioEngine.playTone(520, 'triangle', 0.08);
        };

        window.completeTrainerSetup = function() {
            const rawNameInput = document.getElementById('input-trainer-name');
            const rawName = rawNameInput ? rawNameInput.value.trim() : '';
            state.trainerName = rawName || 'Trainer_' + Math.floor(100 + Math.random() * 900);
            state.party = [createMonsterInstance(state.starterChoice, 5)];
            
            const starterModal = document.getElementById('modal-starter');
            if (starterModal) starterModal.classList.add('hidden');
            
            const hdrName = document.getElementById('hdr-name');
