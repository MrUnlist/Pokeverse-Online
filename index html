<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>Pokeverse-Online | Multiplayer Monster RPG</title>
  <style>
    :root {
      --bg: #0b0f19;
      --panel: #131a2b;
      --panel-border: #24304d;
      --accent: #38bdf8;
      --accent-glow: rgba(56, 189, 248, 0.35);
      --fire: #f97316;
      --water: #3b82f6;
      --volt: #eab308;
      --hp-high: #22c55e;
      --hp-mid: #eab308;
      --hp-low: #ef4444;
      --text: #f1f5f9;
      --muted: #94a3b8;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
      user-select: none;
    }

    body {
      background: radial-gradient(circle at top, #172038 0%, var(--bg) 70%);
      color: var(--text);
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 12px;
    }

    .app {
      width: 100%;
      max-width: 480px;
      background: var(--panel);
      border: 1px solid var(--panel-border);
      border-radius: 16px;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
      overflow: hidden;
      position: relative;
    }

    .topbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 12px 16px;
      background: rgba(9, 13, 22, 0.7);
      border-bottom: 1px solid var(--panel-border);
      font-size: 0.8rem;
    }

    .status-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      color: #4ade80;
      font-weight: 600;
    }

    .dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #4ade80;
      box-shadow: 0 0 8px #4ade80;
    }

    .screen {
      display: none;
      padding: 20px 16px;
    }

    .screen.active {
      display: block;
    }

    /* Title / Lobby Screen */
    .hero {
      text-align: center;
      padding: 16px 0 20px;
    }

    .hero h1 {
      font-size: 1.9rem;
      letter-spacing: 1px;
      background: linear-gradient(90deg, #38bdf8, #818cf8, #f472b6);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      margin-bottom: 8px;
    }

    .hero p {
      color: var(--muted);
      font-size: 0.9rem;
      line-height: 1.4;
    }

    .section-label {
      font-size: 0.78rem;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: var(--muted);
      margin-bottom: 10px;
      font-weight: 700;
    }

    .starter-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
      margin-bottom: 18px;
    }

    .starter-card {
      background: #0f1524;
      border: 2px solid var(--panel-border);
      border-radius: 12px;
      padding: 12px 8px;
      text-align: center;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .starter-card.selected {
      border-color: var(--accent);
      box-shadow: 0 0 16px var(--accent-glow);
      transform: translateY(-2px);
    }

    .starter-icon {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      margin: 0 auto 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 800;
      font-size: 1.1rem;
      color: #fff;
    }

    .starter-name {
      font-weight: 700;
      font-size: 0.9rem;
      margin-bottom: 4px;
    }

    .type-badge {
      display: inline-block;
      font-size: 0.68rem;
      padding: 2px 8px;
      border-radius: 999px;
      font-weight: 700;
      text-transform: uppercase;
    }

    .type-FIRE { background: rgba(249, 115, 22, 0.2); color: #fb923c; border: 1px solid #f97316; }
    .type-WATER { background: rgba(59, 130, 246, 0.2); color: #60a5fa; border: 1px solid #3b82f6; }
    .type-VOLT { background: rgba(234, 179, 8, 0.2); color: #facc15; border: 1px solid #eab308; }

    .lobby-box {
      background: #0f1524;
      border: 1px solid var(--panel-border);
      border-radius: 10px;
      padding: 12px;
      margin-bottom: 18px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.85rem;
    }

    .btn-primary {
      width: 100%;
      padding: 14px;
      border: none;
      border-radius: 12px;
      background: linear-gradient(135deg, #0284c7, #4f46e5);
      color: #fff;
      font-size: 1rem;
      font-weight: 700;
      letter-spacing: 0.5px;
      cursor: pointer;
      box-shadow: 0 8px 20px rgba(2, 132, 199, 0.35);
      transition: transform 0.15s ease, opacity 0.15s ease;
    }

    .btn-primary:active {
      transform: scale(0.98);
    }

    /* Battle Screen */
    .hud-card {
      background: #0f1524;
      border: 1px solid var(--panel-border);
      border-radius: 12px;
      padding: 10px 12px;
    }

    .hud-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 6px;
    }

    .mon-title {
      font-weight: 700;
      font-size: 0.95rem;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .lv-tag {
      font-size: 0.75rem;
      color: var(--muted);
      font-weight: 600;
    }

    .bar-wrap {
      width: 100%;
      height: 10px;
      background: #1e293b;
      border-radius: 999px;
      overflow: hidden;
      margin-bottom: 4px;
    }

    .bar-fill {
      height: 100%;
      width: 100%;
      background: var(--hp-high);
      transition: width 0.25s ease, background-color 0.25s ease;
    }

    .energy-wrap {
      width: 100%;
      height: 5px;
      background: #1e293b;
      border-radius: 999px;
      overflow: hidden;
    }

    .energy-fill {
      height: 100%;
      width: 0%;
      background: var(--accent);
    }

    .hp-numbers {
      display: flex;
      justify-content: space-between;
      font-size: 0.75rem;
      color: var(--muted);
      margin-top: 4px;
    }

    .arena-wrap {
      margin: 12px 0;
      border-radius: 12px;
      overflow: hidden;
      border: 1px solid var(--panel-border);
      background: #080c14;
      position: relative;
    }

    canvas {
      display: block;
      width: 100%;
      height: 210px;
    }

    .battle-log {
      margin: 10px 0;
      background: #090d16;
      border: 1px solid var(--panel-border);
      border-radius: 10px;
      padding: 8px 12px;
      font-size: 0.82rem;
      color: #cbd5e1;
      min-height: 44px;
      display: flex;
      align-items: center;
    }

    .moves-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
      margin-top: 10px;
    }

    .move-btn {
      background: #172036;
      border: 1px solid var(--panel-border);
      border-radius: 10px;
      padding: 10px;
      color: var(--text);
      text-align: left;
      cursor: pointer;
      transition: all 0.15s ease;
    }

    .move-btn:hover:not(:disabled) {
      border-color: var(--accent);
      background: #1e2945;
    }

    .move-btn:disabled {
      opacity: 0.45;
      cursor: not-allowed;
    }

    .move-top {
      display: flex;
      justify-content: space-between;
      font-weight: 700;
      font-size: 0.85rem;
      margin-bottom: 3px;
    }

    .move-sub {
      font-size: 0.72rem;
      color: var(--muted);
      display: flex;
      justify-content: space-between;
    }

    /* Overlay Result */
    .overlay {
      position: absolute;
      inset: 0;
      background: rgba(8, 12, 20, 0.92);
      display: none;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
      padding: 24px;
      z-index: 10;
    }

    .overlay.active {
      display: flex;
    }

    .overlay h2 {
      font-size: 1.8rem;
      margin-bottom: 8px;
    }

    .overlay p {
      color: var(--muted);
      margin-bottom: 20px;
      font-size: 0.92rem;
    }
  </style>
</head>
<body>
  <div class="app">
    <div class="topbar">
      <span class="status-pill"><span class="dot"></span> LOBBY SYNC: ONLINE</span>
      <span id="streak-display" style="color: var(--muted); font-weight: 600;">WINS: 0</span>
    </div>

    <!-- TITLE / LOBBY SCREEN -->
    <div id="title-screen" class="screen active">
      <div class="hero">
        <h1>POKEVERSE-ONLINE</h1>
        <p>Real-time monster arena. Choose your partner and enter live matchmaking.</p>
      </div>

      <div class="section-label">Select Starter Monster</div>
      <div class="starter-grid" id="starter-grid"></div>

      <div class="lobby-box">
        <div>
          <div style="font-weight: 700;">Arena Server #01</div>
          <div style="color: var(--muted); font-size: 0.78rem;">ATB Real-Time Synchronization</div>
        </div>
        <div style="color: #38bdf8; font-weight: 700;" id="room-code">ROOM: #PV-84</div>
      </div>

      <button class="btn-primary" id="start-btn">START BATTLE</button>
    </div>

    <!-- BATTLE SCREEN -->
    <div id="battle-screen" class="screen">
      <!-- Enemy HUD -->
      <div class="hud-card">
        <div class="hud-header">
          <div class="mon-title">
            <span id="enemy-name">Opponent</span>
            <span id="enemy-type" class="type-badge">WATER</span>
          </div>
          <span class="lv-tag" id="enemy-lv">Lv. 5</span>
        </div>
        <div class="bar-wrap"><div class="bar-fill" id="enemy-hp-bar"></div></div>
        <div class="energy-wrap"><div class="energy-fill" id="enemy-en-bar"></div></div>
        <div class="hp-numbers">
          <span>HP</span>
          <span id="enemy-hp-text">100 / 100</span>
        </div>
      </div>

      <!-- Canvas Game Loop Arena -->
      <div class="arena-wrap">
        <canvas id="arena-canvas" width="440" height="210"></canvas>
      </div>

      <!-- Player HUD -->
      <div class="hud-card">
        <div class="hud-header">
          <div class="mon-title">
            <span id="player-name">Player</span>
            <span id="player-type" class="type-badge">FIRE</span>
          </div>
          <span class="lv-tag" id="player-lv">Lv. 5</span>
        </div>
        <div class="bar-wrap"><div class="bar-fill" id="player-hp-bar"></div></div>
        <div class="energy-wrap"><div class="energy-fill" id="player-en-bar"></div></div>
        <div class="hp-numbers">
          <span>ENERGY: <strong id="player-en-text" style="color: var(--accent);">0%</strong></span>
          <span id="player-hp-text">100 / 100</span>
        </div>
      </div>

      <!-- Live Battle Log -->
      <div class="battle-log" id="battle-log">Waiting for energy charge...</div>

      <!-- Attack Options -->
      <div class="moves-grid" id="moves-grid"></div>
    </div>

    <!-- END OVERLAY -->
    <div class="overlay" id="result-overlay">
      <h2 id="result-title">VICTORY!</h2>
      <p id="result-desc">Opponent monster fainted. Arena rank updated.</p>
      <button class="btn-primary" id="rematch-btn" style="max-width: 240px;">NEXT OPPONENT</button>
    </div>
  </div>

  <script>
    const MONSTERS = [
      {
        id: 'pyrodrake',
        name: 'Pyrodrake',
        type: 'FIRE',
        color: '#f97316',
        accent: '#fdba74',
        maxHp: 115,
        atk: 24,
        def: 12,
        spd: 1.05,
        moves: [
          { name: 'Claw Slash', power: 18, cost: 35, type: 'NORMAL', desc: 'Fast physical strike' },
          { name: 'Flame Burst', power: 32, cost: 60, type: 'FIRE', desc: 'High Fire damage' },
          { name: 'Cinder Shield', power: 0, cost: 45, type: 'HEAL', heal: 26, desc: 'Restores 26 HP' },
          { name: 'Inferno Nova', power: 52, cost: 100, type: 'FIRE', desc: 'Ultimate Fire blast' }
        ]
      },
      {
        id: 'aquafin',
        name: 'Aquafin',
        type: 'WATER',
        color: '#3b82f6',
        accent: '#93c5fd',
        maxHp: 125,
        atk: 21,
        def: 15,
        spd: 1.0,
        moves: [
          { name: 'Tail Whip', power: 17, cost: 35, type: 'NORMAL', desc: 'Quick tackle' },
          { name: 'Hydro Pulse', power: 31, cost: 60, type: 'WATER', desc: 'Pressurized water jet' },
          { name: 'Aqua Mend', power: 0, cost: 45, type: 'HEAL', heal: 28, desc: 'Restores 28 HP' },
          { name: 'Tidal Surge', power: 50, cost: 100, type: 'WATER', desc: 'Ultimate Water wave' }
        ]
      },
      {
        id: 'voltfang',
        name: 'Voltfang',
        type: 'VOLT',
        color: '#eab308',
        accent: '#fef08a',
        maxHp: 108,
        atk: 26,
        def: 10,
        spd: 1.18,
        moves: [
          { name: 'Spark Bite', power: 19, cost: 35, type: 'NORMAL', desc: 'Rapid fang strike' },
          { name: 'Thunder Arc', power: 33, cost: 60, type: 'VOLT', desc: 'Piercing Volt shock' },
          { name: 'Charge Up', power: 0, cost: 45, type: 'HEAL', heal: 24, desc: 'Restores 24 HP' },
          { name: 'Overdrive', power: 54, cost: 100, type: 'VOLT', desc: 'Ultimate Volt beam' }
        ]
      }
    ];

    const TYPE_CHART = {
      FIRE: { VOLT: 1.35, WATER: 0.75, FIRE: 1.0 },
      WATER: { FIRE: 1.35, VOLT: 0.75, WATER: 1.0 },
      VOLT: { WATER: 1.35, FIRE: 0.75, VOLT: 1.0 },
      NORMAL: { FIRE: 1.0, WATER: 1.0, VOLT: 1.0 }
    };

    let selectedStarterIdx = 0;
    let wins = 0;
    let state = {
      active: false,
      player: null,
      enemy: null,
      particles: [],
      floatTexts: [],
      lastTime: 0
    };

    const starterGrid = document.getElementById('starter-grid');
    const titleScreen = document.getElementById('title-screen');
    const battleScreen = document.getElementById('battle-screen');
    const resultOverlay = document.getElementById('result-overlay');
    const canvas = document.getElementById('arena-canvas');
    const ctx = canvas.getContext('2d');

    // Render Starter Selection Cards
    function renderStarters() {
      starterGrid.innerHTML = '';
      MONSTERS.forEach((mon, idx) => {
        const card = document.createElement('div');
        card.className = `starter-card ${idx === selectedStarterIdx ? 'selected' : ''}`;
        card.innerHTML = `
          <div class="starter-icon" style="background:${mon.color};">${mon.name[0]}</div>
          <div class="starter-name">${mon.name}</div>
          <span class="type-badge type-${mon.type}">${mon.type}</span>
        `;
        card.onclick = () => {
          selectedStarterIdx = idx;
          renderStarters();
        };
        starterGrid.appendChild(card);
      });
    }

    function createCombatant(template, level, isPlayer) {
      const scale = 1 + (level - 5) * 0.08;
      const maxHp = Math.round(template.maxHp * scale);
      return {
        ...template,
        level,
        maxHp,
        hp: maxHp,
        atk: Math.round(template.atk * scale),
        def: Math.round(template.def * scale),
        energy: isPlayer ? 40 : 25,
        x: isPlayer ? 115 : 325,
        y: isPlayer ? 148 : 85,
        baseX: isPlayer ? 115 : 325,
        baseY: isPlayer ? 148 : 85,
        lunge: 0,
        hurtTimer: 0
      };
    }

    function startBattle() {
      const playerTemplate = MONSTERS[selectedStarterIdx];
      const enemyPool = MONSTERS.filter((_, i) => i !== selectedStarterIdx);
      const enemyTemplate = enemyPool[Math.floor(Math.random() * enemyPool.length)];

      const playerLv = 5 + wins;
      const enemyLv = 5 + wins;

      state.player = createCombatant(playerTemplate, playerLv, true);
      state.enemy = createCombatant(enemyTemplate, enemyLv, false);
      state.particles = [];
      state.floatTexts = [];
      state.active = true;
      state.lastTime = performance.now();

      // Setup HUD
      document.getElementById('player-name').textContent = state.player.name;
      document.getElementById('player-type').textContent = state.player.type;
      document.getElementById('player-type').className = `type-badge type-${state.player.type}`;
      document.getElementById('player-lv').textContent = `Lv. ${state.player.level}`;

      document.getElementById('enemy-name').textContent = state.enemy.name;
      document.getElementById('enemy-type').textContent = state.enemy.type;
      document.getElementById('enemy-type').className = `type-badge type-${state.enemy.type}`;
      document.getElementById('enemy-lv').textContent = `Lv. ${state.enemy.level}`;

      renderMoveButtons();
      updateHud();
      setLog(`Wild rival ${state.enemy.name} entered the arena!`);

      titleScreen.classList.remove('active');
      resultOverlay.classList.remove('active');
      battleScreen.classList.add('active');

      requestAnimationFrame(gameLoop);
    }

    function renderMoveButtons() {
      const grid = document.getElementById('moves-grid');
      grid.innerHTML = '';
      state.player.moves.forEach((move, idx) => {
        const btn = document.createElement('button');
        btn.className = 'move-btn';
        btn.id = `move-btn-${idx}`;
        btn.innerHTML = `
          <div class="move-top">
            <span>${move.name}</span>
            <span style="color: var(--accent);">${move.cost} EN</span>
          </div>
          <div class="move-sub">
            <span>${move.desc}</span>
            <span>${move.type}</span>
          </div>
        `;
        btn.onclick = () => executeMove(state.player, state.enemy, move, true);
        grid.appendChild(btn);
      });
    }

    function setLog(msg) {
      document.getElementById('battle-log').textContent = msg;
    }

    function spawnParticles(x, y, color, count = 14) {
      for (let i = 0; i < count; i++) {
        const angle = (Math.PI * 2 * i) / count + Math.random() * 0.4;
        const speed = 1.5 + Math.random() * 3.5;
        state.particles.push({
          x,
          y,
          vx: Math.cos(angle) * speed,
          vy: Math.sin(angle) * speed,
          life: 1,
          color
        });
      }
    }

    function spawnFloatText(x, y, text, color) {
      state.floatTexts.push({ x, y, text, color, life: 1 });
    }

    function executeMove(attacker, defender, move, isPlayer) {
      if (!state.active || attacker.energy < move.cost) return;

      attacker.energy -= move.cost;
      attacker.lunge = isPlayer ? 24 : -24;

      if (move.type === 'HEAL') {
        const healed = Math.min(attacker.maxHp - attacker.hp, move.heal);
        attacker.hp += healed;
        spawnParticles(attacker.baseX, attacker.baseY, '#4ade80', 12);
        spawnFloatText(attacker.baseX, attacker.baseY - 28, `+${healed} HP`, '#4ade80');
        setLog(`${attacker.name} used ${move.name} and recovered ${healed} HP!`);
      } else {
        const mult = TYPE_CHART[move.type]?.[defender.type] || 1.0;
        const variance = 0.9 + Math.random() * 0.2;
        const raw = ((attacker.atk / Math.max(8, defender.def)) * move.power * 0.65) * mult * variance;
        const dmg = Math.max(4, Math.round(raw));

        defender.hp = Math.max(0, defender.hp - dmg);
        defender.hurtTimer = 0.25;

        spawnParticles(defender.baseX, defender.baseY, attacker.color, 18);
        const tag = mult > 1 ? ' CRIT!' : mult < 1 ? ' (Resist)' : '';
        spawnFloatText(defender.baseX, defender.baseY - 28, `-${dmg}${tag}`, '#f87171');
        setLog(`${attacker.name} used ${move.name} for ${dmg} DMG!${mult > 1 ? ' Super effective!' : ''}`);
      }

      updateHud();
      checkBattleEnd();
    }

    function updateHud() {
      const p = state.player;
      const e = state.enemy;

      const pPct = (p.hp / p.maxHp) * 100;
      const ePct = (e.hp / e.maxHp) * 100;

      const pBar = document.getElementById('player-hp-bar');
      const eBar = document.getElementById('enemy-hp-bar');

      pBar.style.width = `${pPct}%`;
      eBar.style.width = `${ePct}%`;

      pBar.style.backgroundColor = pPct > 50 ? 'var(--hp-high)' : pPct > 25 ? 'var(--hp-mid)' : 'var(--hp-low)';
      eBar.style.backgroundColor = ePct > 50 ? 'var(--hp-high)' : ePct > 25 ? 'var(--hp-mid)' : 'var(--hp-low)';

      document.getElementById('player-hp-text').textContent = `${p.hp} / ${p.maxHp}`;
      document.getElementById('enemy-hp-text').textContent = `${e.hp} / ${e.maxHp}`;

      document.getElementById('player-en-bar').style.width = `${p.energy}%`;
      document.getElementById('enemy-en-bar').style.width = `${e.energy}%`;
      document.getElementById('player-en-text').textContent = `${Math.floor(p.energy)}%`;

      p.moves.forEach((m, idx) => {
        const btn = document.getElementById(`move-btn-${idx}`);
        if (btn) btn.disabled = p.energy < m.cost || !state.active;
      });
    }

    function checkBattleEnd() {
      if (state.enemy.hp <= 0 || state.player.hp <= 0) {
        state.active = false;
        const playerWon = state.enemy.hp <= 0;
        if (playerWon) {
          wins++;
          document.getElementById('streak-display').textContent = `WINS: ${wins}`;
        }
        setTimeout(() => {
          document.getElementById('result-title').textContent = playerWon ? 'VICTORY!' : 'DEFEAT';
          document.getElementById('result-title').style.color = playerWon ? '#4ade80' : '#f87171';
          document.getElementById('result-desc').textContent = playerWon
            ? `${state.enemy.name} was defeated! Your monster leveled up to Lv. ${5 + wins}.`
            : `${state.player.name} fainted! Regroup and challenge the arena again.`;
          resultOverlay.classList.add('active');
        }, 550);
      }
    }

    function updateEnemyAI() {
      const e = state.enemy;
      const available = e.moves.filter(m => e.energy >= m.cost);
      if (available.length === 0) return;

      const healMove = available.find(m => m.type === 'HEAL');
      if (healMove && e.hp < e.maxHp * 0.4 && Math.random() < 0.65) {
        executeMove(e, state.player, healMove, false);
        return;
      }

      if (e.energy >= 60 || Math.random() < 0.04) {
        const attacks = available.filter(m => m.type !== 'HEAL');
        const chosen = attacks[Math.floor(Math.random() * attacks.length)] || available[0];
        executeMove(e, state.player, chosen, false);
      }
    }

    function drawMonster(mon, timeSec, isPlayer) {
      const bob = Math.sin(timeSec * 4 + (isPlayer ? 0 : 2)) * 4;
      mon.lunge *= 0.84;
      const x = mon.baseX + mon.lunge;
      const y = mon.baseY + bob;

      ctx.fillStyle = 'rgba(56, 189, 248, 0.14)';
      ctx.beginPath();
      ctx.ellipse(mon.baseX, mon.baseY + 26, 42, 11, 0, 0, Math.PI * 2);
      ctx.fill();

      const isHurt = mon.hurtTimer > 0;
      ctx.save();
      ctx.translate(x, y);

      ctx.strokeStyle = isHurt ? '#ffffff' : mon.accent;
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.arc(0, 0, 27, 0, Math.PI * 2);
      ctx.stroke();

      ctx.fillStyle = isHurt ? '#f87171' : mon.color;
      ctx.beginPath();
      ctx.arc(0, 0, 22, 0, Math.PI * 2);
      ctx.fill();

      const dir = isPlayer ? 1 : -1;
      ctx.fillStyle = '#ffffff';
      ctx.beginPath();
      ctx.arc(7 * dir, -4, 4.5, 0, Math.PI * 2);
      ctx.fill();

      ctx.fillStyle = '#0f172a';
      ctx.beginPath();
      ctx.arc(8.5 * dir, -4, 2.2, 0, Math.PI * 2);
      ctx.fill();

      ctx.restore();
    }

    function gameLoop(now) {
      const dt = Math.min(0.05, (now - state.lastTime) / 1000);
      state.lastTime = now;

      if (state.active) {
        state.player.energy = Math.min(100, state.player.energy + dt * 22 * state.player.spd);
        state.enemy.energy = Math.min(100, state.enemy.energy + dt * 20 * state.enemy.spd);

        if (state.player.hurtTimer > 0) state.player.hurtTimer -= dt;
        if (state.enemy.hurtTimer > 0) state.enemy.hurtTimer -= dt;

        updateEnemyAI();
        updateHud();
      }

      ctx.clearRect(0, 0, canvas.width, canvas.height);

      ctx.strokeStyle = 'rgba(36, 48, 77, 0.45)';
      ctx.lineWidth = 1;
      for (let gx = 0; gx < canvas.width; gx += 40) {
        ctx.beginPath();
        ctx.moveTo(gx, 0);
        ctx.lineTo(gx, canvas.height);
        ctx.stroke();
      }

      if (state.enemy && state.player) {
        const t = now / 1000;
        drawMonster(state.enemy, t, false);
        drawMonster(state.player, t, true);
      }

      for (let i = state.particles.length - 1; i >= 0; i--) {
        const pt = state.particles[i];
        pt.x += pt.vx;
        pt.y += pt.vy;
        pt.life -= dt * 2.2;
        if (pt.life <= 0) {
          state.particles.splice(i, 1);
          continue;
        }
        ctx.globalAlpha = pt.life;
        ctx.fillStyle = pt.color;
        ctx.beginPath();
        ctx.arc(pt.x, pt.y, 4 * pt.life, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.globalAlpha = 1;

      for (let i = state.floatTexts.length - 1; i >= 0; i--) {
        const ft = state.floatTexts[i];
        ft.y -= dt * 28;
        ft.life -= dt * 1.1;
        if (ft.life <= 0) {
          state.floatTexts.splice(i, 1);
          continue;
        }
        ctx.globalAlpha = ft.life;
        ctx.fillStyle = ft.color;
        ctx.font = 'bold 14px sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText(ft.text, ft.x, ft.y);
      }
      ctx.globalAlpha = 1;

      if (state.active || state.particles.length > 0 || state.floatTexts.length > 0) {
        requestAnimationFrame(gameLoop);
      }
    }

    document.getElementById('start-btn').onclick = startBattle;
    document.getElementById('rematch-btn').onclick = startBattle;
    renderStarters();
  </script>
</body>
</html>
