                pebbleon: `<svg viewBox="0 0 100 100" class="w-full h-full drop-shadow-md"><g ${transform}>
                    <polygon points="26,72 22,46 38,26 62,26 78,46 74,72" fill="#94a3b8" stroke="#475569" stroke-width="3"/>
                    <circle cx="41" cy="46" r="4" fill="#0f172a"/><circle cx="42" cy="45" r="1.5" fill="#facc15"/>
                    <circle cx="59" cy="46" r="4" fill="#0f172a"/><circle cx="60" cy="45" r="1.5" fill="#facc15"/>
                    <path d="M40 60 L48 56 L56 60" stroke="#334155" stroke-width="3" fill="none"/>
