<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>PokeVerse Online - Multiplayer Monster RPG</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&family=Press+Start+2P&display=swap" rel="stylesheet">
    <style>
        :root {
            --gb-dark: #0f172a;
            --gb-panel: #1e293b;
            --gb-accent: #ef4444;
            --gb-screen: #9bbc0f;
        }
        body {
            font-family: 'Inter', sans-serif;
            background-color: #090d16;
            color: #f8fafc;
            overflow-x: hidden;
            user-select: none;
            -webkit-tap-highlight-color: transparent;
        }
        .font-pixel {
            font-family: 'Press Start 2P', monospace;
        }
        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: #0f172a; }
        ::-webkit-scrollbar-thumb { background: #334155; border-radius: 3px; }
        ::-webkit-scrollbar-thumb:hover { background: #475569; }

        /* Battle & UI Animations */
        @keyframes float {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-6px); }
        }
        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            20% { transform: translateX(-8px); }
            40% { transform: translateX(8px); }
            60% { transform: translateX(-6px); }
            80% { transform: translateX(6px); }
        }
        @keyframes attackLungePlayer {
            0% { transform: translate(0, 0); }
            40% { transform: translate(35px, -20px) scale(1.1); }
            100% { transform: translate(0, 0); }
        }
        @keyframes attackLungeEnemy {
            0% { transform: translate(0, 0); }
            40% { transform: translate(-35px, 20px) scale(1.1); }
            100% { transform: translate(0, 0); }
        }
        @keyframes wobble {
            0%, 100% { transform: rotate(0deg); }
            25% { transform: rotate(-20deg); }
            75% { transform: rotate(20deg); }
        }
        @keyframes flashWhite {
            0%, 100% { filter: brightness(1); }
            50% { filter: brightness(3) invert(0.2); }
        }
        .anim-float { animation: float 2.4s ease-in-out infinite; }
        .anim-shake { animation: shake 0.4s ease-in-out; }
        .anim-lunge-player { animation: attackLungePlayer 0.35s ease-out; }
        .anim-lunge-enemy { animation: attackLungeEnemy 0.35s ease-out; }
        .anim-wobble { animation: wobble 0.6s ease-in-out infinite; }
        .anim-hit { animation: flashWhite 0.25s ease-in-out 2; }

        /* Retro scanline overlay for game screen */
        .crt-overlay {
            background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.15) 50%);
            background-size: 100% 4px;
            pointer-events: none;
        }
        canvas {
            image-rendering: pixelated;
            image-rendering: crisp-edges;
        }
        .btn-3d {
            transition: all 0.1s;
            box-shadow: 0 4px 0 rgba(0,0,0,0.4);
        }
        .btn-3d:active {
            transform: translateY(3px);
            box-shadow: 0 1px 0 rgba(0,0,0,0.4);
        }
    </style>
</head>
<body class="min-h-screen flex flex-col">

    <!-- TOP SERVER STATUS BAR -->
    <header class="bg-slate-900/95 border-b border-slate-800 px-3 py-2 sticky top-0 z-40 backdrop-blur">
        <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-2">
            <div class="flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-full bg-gradient-to-b from-red-500 via-red-600 to-white border-2 border-slate-950 flex items-center justify-center relative shadow-md">
                    <div class="w-full h-0.5 bg-slate-950 absolute"></div>
                    <div class="w-2.5 h-2.5 rounded-full bg-white border-2 border-slate-950 z-10"></div>
                </div>
                <div>
                    <h1 class="font-pixel text-xs sm:text-sm text-amber-400 tracking-wider">POKEVERSE ONLINE</h1>
                    <div class="flex items-center gap-2 text-[11px] text-slate-400">
                        <span class="flex items-center gap-1">
                            <span id="server-dot" class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                            <span id="server-region">ASIA-SOUTH-01</span>
                        </span>
                        <span>•</span>
                        <span>Ping: <strong id="server-ping" class="text-emerald-400">24ms</strong></span>
                        <span>•</span>
                        <span>Online: <strong id="online-count" class="text-sky-400">1</strong></span>
                    </div>
                </div>
            </div>

            <!-- Trainer Quick Stats & Controls -->
            <div class="flex items-center gap-2">
                <div id="header-trainer-badge" class="hidden sm:flex items-center gap-2 bg-slate-800/90 border border-slate-700 px-3 py-1 rounded-full text-xs">
                    <span class="text-amber-400 font-bold" id="hdr-name">Trainer</span>
                    <span class="text-slate-500">|</span>
                    <span class="text-emerald-400">🏆 <span id="hdr-wins">0</span>W</span>
                    <span class="text-sky-400">🔮 <span id="hdr-caught">1</span></span>
                    <span class="text-yellow-300">💰 $<span id="hdr-money">500</span></span>
                </div>
                <button type="button" id="btn-sound" onclick="AudioEngine.toggleMute()" class="p-2 rounded-lg bg-slate-800 hover:bg-slate-700 border border-slate-700 text-xs font-semibold" title="Toggle Sound">
                    🔊 SFX
                </button>
                <button type="button" onclick="openModal('modal-server-logs')" class="p-2 rounded-lg bg-slate-800 hover:bg-slate-700 border border-slate-700 text-xs font-semibold text-sky-400">
                    📡 Server
                </button>
            </div>
        </div>
    </header>

    <!-- MAIN CONTENT GRID -->
    <main class="flex-1 max-w-7xl w-full mx-auto p-2 sm:p-4 grid grid-cols-1 lg:grid-cols-12 gap-4">

        <!-- LEFT/CENTER: MAIN CONSOLE VIEWPORT (7 cols on lg) -->
        <section class="lg:col-span-7 flex flex-col gap-3">
            <!-- Console Bezel -->
            <div class="bg-slate-900 border-2 border-slate-700/80 rounded-2xl p-2 sm:p-3 shadow-2xl relative overflow-hidden">
                <!-- Top Console Indicator -->
                <div class="flex items-center justify-between mb-2 px-1">
                    <div class="flex items-center gap-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-red-500 shadow-[0_0_8px_#ef4444]"></span>
                        <span class="text-[10px] font-pixel text-slate-400 uppercase" id="screen-mode-label">OVERWORLD // PALLET VALLEY</span>
                    </div>
                    <div class="flex gap-1.5">
                        <button type="button" onclick="healAllParty(true)" class="text-[11px] bg-emerald-600/20 hover:bg-emerald-600/40 text-emerald-300 border border-emerald-500/40 px-2 py-0.5 rounded font-semibold">
                            🏥 Quick Heal
                        </button>
                        <button type="button" onclick="openShopModal()" class="text-[11px] bg-amber-600/20 hover:bg-amber-600/40 text-amber-300 border border-amber-500/40 px-2 py-0.5 rounded font-semibold">
                            🏪 PokeMart
                        </button>
                    </div>
                </div>

                <!-- VIEWPORT CONTAINER (Aspect 4:3 on desktop, adaptive on mobile) -->
                <div class="relative w-full aspect-[4/3] max-h-[520px] bg-slate-950 rounded-xl overflow-hidden border-2 border-slate-800 shadow-inner">
                    
                    <!-- 1. OVERWORLD CANVAS -->
                    <canvas id="overworld-canvas" class="w-full h-full block"></canvas>

                    <!-- 2. TURN-BASED BATTLE SCREEN -->
                    <div id="battle-screen" class="hidden absolute inset-0 flex flex-col justify-between bg-gradient-to-b from-sky-300 via-sky-200 to-emerald-200 text-slate-900 z-20">
                        <!-- Battle Top Status Bar -->
                        <div class="p-2 sm:p-3 flex justify-between items-start z-10">
                            <!-- Enemy HUD -->
                            <div class="bg-slate-900/90 text-white border-2 border-slate-700 rounded-xl p-2 sm:p-2.5 w-44 sm:w-56 shadow-lg">
                                <div class="flex justify-between items-center text-xs font-bold mb-1">
                                    <span id="enemy-name" class="truncate text-amber-300">WILD MON</span>
                                    <span class="text-[10px] bg-slate-800 px-1.5 py-0.5 rounded text-slate-300">Lv.<span id="enemy-lvl">5</span></span>
                                </div>
                                <div class="flex items-center gap-1.5">
                                    <span class="text-[9px] font-pixel text-amber-400">HP</span>
                                    <div class="flex-1 h-2.5 bg-slate-700 rounded-full overflow-hidden border border-slate-600">
                                        <div id="enemy-hp-bar" class="h-full bg-emerald-400 transition-all duration-300" style="width: 100%"></div>
                                    </div>
                                </div>
                                <div class="flex justify-between items-center mt-1 text-[10px] text-slate-400">
                                    <span id="enemy-type-badge" class="uppercase font-bold px-1.5 rounded bg-slate-800">GRASS</span>
                                    <span id="enemy-hp-text">20/20</span>
                                </div>
                            </div>

                            <!-- PvP / Wild Tag -->
                            <div id="battle-mode-tag" class="bg-red-600 text-white font-pixel text-[9px] px-2.5 py-1 rounded-full shadow border border-red-400">
                                WILD ENCOUNTER
                            </div>
                        </div>

                        <!-- Battle Arena Visuals -->
                        <div class="relative flex-1 flex items-center justify-between px-4 sm:px-10">
                            <!-- Enemy Platform & Sprite -->
                            <div class="absolute right-6 sm:right-14 top-1 sm:top-4 flex flex-col items-center">
                                <div id="enemy-sprite-box" class="w-24 h-24 sm:w-32 sm:h-32 flex items-center justify-center anim-float z-10">
                                    <!-- SVG injected by JS -->
                                </div>
                                <div class="w-28 sm:w-36 h-7 bg-emerald-600/40 border-2 border-emerald-700/30 rounded-[100%] -mt-4"></div>
                            </div>

                            <!-- Capture Orb Animation Overlay -->
                            <div id="capture-orb-anim" class="hidden absolute right-14 sm:right-24 top-10 z-20">
                                <div class="w-8 h-8 rounded-full bg-gradient-to-b from-red-500 to-white border-2 border-slate-900 shadow-lg flex items-center justify-center anim-wobble">
                                    <div class="w-2 h-2 rounded-full bg-white border border-slate-900"></div>
                                </div>
                            </div>

                            <!-- Player Platform & Sprite -->
                            <div class="absolute left-6 sm:left-14 bottom-1 sm:bottom-3 flex flex-col items-center">
                                <div id="player-sprite-box" class="w-28 h-28 sm:w-36 sm:h-36 flex items-center justify-center z-10">
                                    <!-- SVG injected by JS -->
                                </div>
                                <div class="w-32 sm:w-40 h-8 bg-emerald-600/40 border-2 border-emerald-700/30 rounded-[100%] -mt-5"></div>
                            </div>

                            <!-- Player HUD -->
                            <div class="absolute right-2 sm:right-4 bottom-2 bg-slate-900/90 text-white border-2 border-slate-700 rounded-xl p-2 sm:p-2.5 w-48 sm:w-60 shadow-lg z-10">
                                <div class="flex justify-between items-center text-xs font-bold mb-1">
                                    <span id="player-mon-name" class="truncate text-sky-300">EMBERCUB</span>
                                    <span class="text-[10px] bg-slate-800 px-1.5 py-0.5 rounded text-slate-300">Lv.<span id="player-mon-lvl">5</span></span>
                                </div>
                                <div class="flex items-center gap-1.5">
                                    <span class="text-[9px] font-pixel text-amber-400">HP</span>
                                    <div class="flex-1 h-2.5 bg-slate-700 rounded-full overflow-hidden border border-slate-600">
                                        <div id="player-hp-bar" class="h-full bg-emerald-400 transition-all duration-300" style="width: 100%"></div>
                                    </div>
                                </div>
                                <div class="flex justify-between items-center mt-1 text-[10px] text-slate-300">
                                    <span id="player-type-badge" class="uppercase font-bold px-1.5 rounded bg-slate-800">FIRE</span>
                                    <span id="player-hp-text">22/22</span>
                                </div>
                                <!-- XP Bar -->
                                <div class="mt-1.5 flex items-center gap-1">
                                    <span class="text-[8px] font-pixel text-sky-400">XP</span>
                                    <div class="flex-1 h-1.5 bg-slate-800 rounded-full overflow-hidden">
                                        <div id="player-xp-bar" class="h-full bg-sky-400 transition-all duration-300" style="width: 20%"></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Battle Command Deck -->
                        <div class="bg-slate-900 border-t-2 border-slate-700 p-2 sm:p-3 text-white grid grid-cols-1 sm:grid-cols-12 gap-2 z-20">
                            <!-- Battle Dialogue Log -->
                            <div class="sm:col-span-6 bg-slate-950 border border-slate-700 rounded-lg p-2.5 flex items-center min-h-[64px]">
                                <p id="battle-log-text" class="text-xs sm:text-sm font-medium leading-snug text-slate-100">
                                    A wild creature appeared! What will you do?
                                </p>
                            </div>

                            <!-- Action Buttons / Submenus -->
                            <div id="battle-actions-main" class="sm:col-span-6 grid grid-cols-2 gap-1.5">
                                <button type="button" onclick="showBattleMoves()" class="btn-3d bg-red-600 hover:bg-red-500 text-white font-bold py-2 px-3 rounded-lg text-xs sm:text-sm flex items-center justify-center gap-1.5">
                                    ⚔️ FIGHT
                                </button>
                                <button type="button" onclick="showBattleBag()" class="btn-3d bg-amber-600 hover:bg-amber-500 text-white font-bold py-2 px-3 rounded-lg text-xs sm:text-sm flex items-center justify-center gap-1.5">
                                    🎒 BAG
                                </button>
                                <button type="button" onclick="showBattleParty()" class="btn-3d bg-emerald-600 hover:bg-emerald-500 text-white font-bold py-2 px-3 rounded-lg text-xs sm:text-sm flex items-center justify-center gap-1.5">
                                    🐾 PARTY
                                </button>
                                <button type="button" onclick="attemptRun()" class="btn-3d bg-slate-700 hover:bg-slate-600 text-white font-bold py-2 px-3 rounded-lg text-xs sm:text-sm flex items-center justify-center gap-1.5">
                                    🏃 RUN
                                </button>
                            </div>

                            <!-- Moves Submenu -->
                            <div id="battle-actions-moves" class="hidden sm:col-span-6 grid grid-cols-2 gap-1.5">
                                <!-- Injected dynamically -->
                            </div>

                            <!-- Bag Submenu -->
                            <div id="battle-actions-bag" class="hidden sm:col-span-6 grid grid-cols-2 gap-1.5">
                                <button type="button" onclick="useBagItem('potion')" class="btn-3d bg-emerald-700 hover:bg-emerald-600 p-1.5 rounded-lg text-left text-xs">
                                    <div class="font-bold">🧪 Potion (<span id="bag-potion-count">3</span>)</div>
                                    <div class="text-[10px] text-emerald-200">Restores 25 HP</div>
                                </button>
                                <button type="button" onclick="useBagItem('orb')" class="btn-3d bg-rose-700 hover:bg-rose-600 p-1.5 rounded-lg text-left text-xs">
                                    <div class="font-bold">🔴 Capture Orb (<span id="bag-orb-count">5</span>)</div>
                                    <div class="text-[10px] text-rose-200">Catch wild mon</div>
                                </button>
                                <button type="button" onclick="useBagItem('superorb')" class="btn-3d bg-indigo-700 hover:bg-indigo-600 p-1.5 rounded-lg text-left text-xs">
                                    <div class="font-bold">🟣 Ultra Orb (<span id="bag-superorb-count">1</span>)</div>
                                    <div class="text-[10px] text-indigo-200">2x Catch Rate</div>
                                </button>
                                <button type="button" onclick="resetBattleMenu()" class="btn-3d bg-slate-700 hover:bg-slate-600 p-1.5 rounded-lg font-bold text-xs flex items-center justify-center">
                                    ↩ Back
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Transition Flash Overlay -->
                    <div id="battle-flash" class="hidden absolute inset-0 bg-white z-30 pointer-events-none"></div>
                    <!-- Subtle CRT lines -->
                    <div class="crt-overlay absolute inset-0 z-10"></div>
                </div>

                <!-- MOBILE / ON-SCREEN CONTROLS + PARTY BAR -->
                <div class="mt-3 grid grid-cols-1 sm:grid-cols-12 gap-3 items-center">
                    <!-- D-Pad for Touch & Click -->
                    <div class="sm:col-span-5 flex items-center justify-center gap-4 bg-slate-800/70 p-2 rounded-xl border border-slate-700/60">
                        <div class="grid grid-cols-3 gap-1 w-28 h-28">
                            <div></div>
                            <button type="button" onpointerdown="setMoveInput('up', true)" onpointerup="setMoveInput('up', false)" onpointerleave="setMoveInput('up', false)" onpointercancel="setMoveInput('up', false)" class="bg-slate-700 active:bg-amber-500 rounded-lg flex items-center justify-center text-lg font-bold shadow">▲</button>
                            <div></div>
                            <button type="button" onpointerdown="setMoveInput('left', true)" onpointerup="setMoveInput('left', false)" onpointerleave="setMoveInput('left', false)" onpointercancel="setMoveInput('left', false)" class="bg-slate-700 active:bg-amber-500 rounded-lg flex items-center justify-center text-lg font-bold shadow">◀</button>
                            <div class="bg-slate-900 rounded-lg flex items-center justify-center text-[10px] text-slate-500">PAD</div>
                            <button type="button" onpointerdown="setMoveInput('right', true)" onpointerup="setMoveInput('right', false)" onpointerleave="setMoveInput('right', false)" onpointercancel="setMoveInput('right', false)" class="bg-slate-700 active:bg-amber-500 rounded-lg flex items-center justify-center text-lg font-bold shadow">▶</button>
                            <div></div>
                            <button type="button" onpointerdown="setMoveInput('down', true)" onpointerup="setMoveInput('down', false)" onpointerleave="setMoveInput('down', false)" onpointercancel="setMoveInput('down', false)" class="bg-slate-700 active:bg-amber-500 rounded-lg flex items-center justify-center text-lg font-bold shadow">▼</button>
                            <div></div>
                        </div>
                        <div class="flex flex-col gap-2">
                            <button type="button" onclick="interactOverworld()" class="btn-3d w-14 h-14 rounded-full bg-red-600 active:bg-red-500 text-white font-pixel text-xs shadow-lg border-2 border-red-400">
                                A
                            </button>
                            <span class="text-[10px] text-center text-slate-400">Interact / Grass</span>
                        </div>
                    </div>

                    <!-- Active Squad Bar -->
                    <div class="sm:col-span-7 bg-slate-800/70 p-2.5 rounded-xl border border-slate-700/60">
                        <div class="flex justify-between items-center mb-1.5">
                            <span class="text-xs font-bold text-slate-300 uppercase tracking-wider">Your Squad (<span id="party-count">1</span>/6)</span>
                            <button type="button" onclick="triggerWildEncounter()" class="text-[11px] bg-emerald-600 hover:bg-emerald-500 text-white px-2.5 py-0.5 rounded-full font-semibold shadow">
                                🌿 Hunt Wild Mon
                            </button>
                        </div>
                        <div id="party-slots" class="grid grid-cols-3 sm:grid-cols-6 gap-1.5">
                            <!-- Party cards injected by JS -->
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- RIGHT: ONLINE MULTIPLAYER SERVER LOBBY, CHAT & LEADERBOARD (5 cols on lg) -->
        <aside class="lg:col-span-5 flex flex-col gap-3">
            <!-- Matchmaking & Quick PvP Banner -->
            <div class="bg-gradient-to-r from-indigo-900/90 via-slate-900 to-purple-900/90 border border-indigo-500/40 rounded-2xl p-3.5 shadow-xl">
                <div class="flex items-center justify-between gap-2">
                    <div>
                        <span class="text-[10px] font-bold uppercase tracking-wider text-indigo-300 bg-indigo-950/80 px-2 py-0.5 rounded border border-indigo-500/30">Ranked & Casual PvP</span>
                        <h2 class="text-base font-extrabold text-white mt-1">Online Battle Arena</h2>
                        <p class="text-xs text-slate-300">Battle real online trainers or challenge Server Bots!</p>
                    </div>
                    <button type="button" onclick="startQuickMatchmaking()" id="btn-quick-match" class="btn-3d bg-amber-500 hover:bg-amber-400 text-slate-950 font-extrabold text-xs px-3.5 py-2.5 rounded-xl shadow-lg whitespace-nowrap">
                        ⚡ Quick PvP
                    </button>
                </div>
            </div>

            <!-- Tabs: Lobby / Global Chat / Leaderboard -->
            <div class="bg-slate-900 border border-slate-800 rounded-2xl flex-1 flex flex-col overflow-hidden shadow-xl min-h-[420px]">
                <div class="grid grid-cols-3 border-b border-slate-800 bg-slate-950/60 text-xs font-bold">
                    <button type="button" onclick="switchLobbyTab('trainers')" id="tab-trainers" class="py-2.5 text-amber-400 border-b-2 border-amber-400 bg-slate-900/60">
                        🌐 Trainers (<span id="tab-online-count">1</span>)
                    </button>
                    <button type="button" onclick="switchLobbyTab('chat')" id="tab-chat" class="py-2.5 text-slate-400 hover:text-slate-200">
                        💬 Global Chat
                    </button>
                    <button type="button" onclick="switchLobbyTab('ranks')" id="tab-ranks" class="py-2.5 text-slate-400 hover:text-slate-200">
                        🏆 Leaderboard
                    </button>
                </div>

                <!-- TAB 1: ONLINE TRAINERS LOBBY -->
                <div id="panel-trainers" class="p-3 flex-1 overflow-y-auto space-y-2 max-h-[430px]">
                    <div class="flex justify-between items-center text-[11px] text-slate-400 pb-1">
                        <span>Connected to <strong class="text-slate-200">Global Relay</strong></span>
                        <span id="your-uid-tag" class="font-mono text-[10px] text-slate-500">ID: connecting...</span>
                    </div>
                    <div id="online-trainers-list" class="space-y-2">
                        <!-- Trainer rows injected by JS -->
                    </div>
                </div>

                <!-- TAB 2: GLOBAL REAL-TIME CHAT -->
                <div id="panel-chat" class="hidden flex-1 flex flex-col max-h-[430px]">
                    <div id="chat-messages" class="flex-1 p-3 overflow-y-auto space-y-2 text-xs">
                        <div class="bg-slate-800/60 text-sky-300 p-2 rounded-lg border border-slate-700/50">
                            <strong>[SERVER]:</strong> Welcome to PokeVerse Online! Walk in tall grass to catch monsters or challenge trainers in the lobby.
                        </div>
                    </div>
                    <form onsubmit="sendChatMessage(event)" class="p-2 border-t border-slate-800 bg-slate-950 flex gap-1.5">
                        <input type="text" id="chat-input" maxlength="120" placeholder="Say hello to online trainers..." class="flex-1 bg-slate-900 border border-slate-700 rounded-lg px-3 py-1.5 text-xs text-white focus:outline-none focus:border-amber-400">
                        <button type="submit" class="bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold px-3 py-1.5 rounded-lg text-xs">
                            Send
                        </button>
                    </form>
                </div>

                <!-- TAB 3: LEADERBOARD -->
                <div id="panel-ranks" class="hidden p-3 flex-1 overflow-y-auto space-y-2 max-h-[430px]">
                    <div class="text-[11px] text-slate-400 mb-1">Top Trainers by PvP Wins & Monsters Caught</div>
                    <div id="leaderboard-list" class="space-y-1.5">
                        <!-- Leaderboard rows injected by JS -->
                    </div>
                </div>
            </div>
        </aside>
    </main>

    <!-- MODAL 1: TRAINER CREATION / STARTER SELECTION -->
    <div id="modal-starter" class="fixed inset-0 bg-slate-950/90 backdrop-blur-sm z-50 flex items-center justify-center p-4">
